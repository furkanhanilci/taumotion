digraph architecture {
graph [rankdir=LR,bgcolor="white",pad="0.4",nodesep=".5",ranksep=".85",splines=polyline,compound=true,labelloc="t",labeljust="l",label="τMOTION  |  Çevrim Dışı Eğitim ve Doğrulama\nv1.2 · Uzman → görünürlük → çoklu hedef → critic → PPO/CVaR → held-out benchmark",fontname="DejaVu Sans",fontsize=26,fontcolor="#61268c",size="25,10",ratio=auto];
node [fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans"];
subgraph cluster_ing {label="VERİ / KAYNAK SINIRI";color="#5284c7";style="rounded,dashed";penwidth=1.8; bgcolor="#eaf2ff";
"data" [label="ÇEŞİTLİ SÜRÜŞ KAYITLARI\nGerçek kayıtlar + CARLA / NAVSIM\nRig/rota/senaryo/seed fingerprint",shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#5284c7",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
"expert" [label="UZMAN POLİTİKA ve DATA\nKlasik ayrıcalıklı uzman + native kontrol\nÖğrenciye oracle bilgi VERİLMEZ",shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#5284c7",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.1,margin="0.22,0.18"];
"cache" [label="VERSİYONLU VERİ ÖNBELLEĞİ\nÖn işleme / model / dataset hash\nEski cache uyuşmazsa RED",shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#5284c7",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
}
subgraph cluster_teac {label="OFFLINE DENETİM - ORACLE İZOLASYONU";color="#8452b0";style="rounded,dashed";penwidth=1.8; bgcolor="#f1eaff";
"vis" [label="GÖRÜNÜRLÜK / ÖRTÜLME ETİKETİ\nNesne mevcut ≠ sensörde görünür\nOffline instance/depth/LiDAR etiketleri",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.0,margin="0.22,0.18"];
"teacher" [label="GELECEK BİLGİLİ ÖĞRETMEN\nYalnız eğitimde gelecek veri\nKarşı-olgusal sonuç: rollout gerekir",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.15,margin="0.22,0.18"];
"multi" [label="ÇOKLU GEÇERLİ YÖRÜNGE HEDEFİ\nTek insan hareketi tek doğru değil\nGeçerlilik maskesi + etiket kaynağı",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.1,margin="0.22,0.18"];
}
subgraph cluster_train {label="EĞİTİM AŞAMASI I";color="#ca943a";style="rounded,dashed";penwidth=1.8; bgcolor="#fff2d9";
"critic" [label="SAFETY CRITIC EĞİTİMİ\nNC/DAC/TTC/DDC/EP/konfor\nRanking + false-safe + kalibrasyon",shape=box,style="rounded,filled",fillcolor="#fff2d9",color="#ca943a",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.1,margin="0.22,0.18"];
"ranker" [label="SUPERVISED ADAY SIRALAMA\nHeuristic / fiziksel / çoklu skor\nAynı frozen aday havuzu",shape=box,style="rounded,filled",fillcolor="#fff2d9",color="#ca943a",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
}
subgraph cluster_ppo {label="EĞİTİM AŞAMASI II";color="#bd527e";style="rounded,dashed";penwidth=1.8; bgcolor="#ffedf5";
"rl" [label="CARLA KAPALI DÖNGÜ PPO\nAday seçimi + 8D residual\nEpisode maliyeti / CVaR pilotu",shape=box,style="rounded,filled",fillcolor="#ffedf5",color="#bd527e",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
}
subgraph cluster_eva {label="ÖLÇÜM / İYİLEŞTİRME";color="#429269";style="rounded,dashed";penwidth=1.8; bgcolor="#e9f6ed";
"eval" [label="BAĞIMSIZ KIYASLAMA\nNAVSIM PDMS/EPDMS · KITScenes ADE/FDE\nCARLA DS/SR · XAI · P95/P99 gecikme",shape=box,style="rounded,filled",fillcolor="#e9f6ed",color="#429269",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.4,margin="0.22,0.18"];
"fail" [label="HATA ANALİZİ ve YENİ SÜRÜM\nÖrtülme · domain · risk kuyruğu\nTest rotası eğitime karıştırılmaz",shape=box,style="rounded,filled",fillcolor="#e9f6ed",color="#429269",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
}
"data"->"expert" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"data"->"vis" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"expert"->"teacher" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"teacher"->"multi" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"vis"->"multi" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"multi"->"cache" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"vis"->"cache" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"cache"->"critic" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"cache"->"ranker" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"critic"->"rl" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"ranker"->"rl" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"rl"->"eval" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"eval"->"fail" [color="#77619b",penwidth=2.0,arrowsize=.8,style=solid,constraint=true];
"fail"->"data" [color="#7b57b1",penwidth=2.0,arrowsize=.8,style=dashed,constraint=false,label="yeni TRAIN senaryosu",fontsize=10,fontcolor="#47556c"];
}