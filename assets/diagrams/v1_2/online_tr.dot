"vlm" [label="M03  GÖRSEL–DİL MUHAKEMESİ\nSahne bağlamı · kurallar · niyet",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
"cot" [label="M04–M05  CoT + ZAMANSAL MUHAKEME\nAktör, tehlike, neden, eylem, 0–4s",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=2.55,margin="0.22,0.18"];
"ground" [label="M06  KANIT / GÖRÜNÜRLÜK\nDestekli / çelişkili / bilinmiyor\nÖrtülme, belirsizlik ve kalibrasyon",shape=box,style="rounded,filled",fillcolor="#f1eaff",color="#8452b0",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.0,margin="0.22,0.18"];
