digraph architecture {
graph [rankdir=LR,bgcolor="white",pad="0.4",nodesep=".5",ranksep=".85",splines=polyline,compound=true,labelloc="t",labeljust="l",label="τMOTION  |  Nihai Çevrim İçi Sürüş Mimarisi\nv1.2 · Aynı 24 ana modül · M10 içinde yeni küçük Safety Critic · Birden çok hız ve geri besleme",fontname="DejaVu Sans",fontsize=26,fontcolor="#61268c",size="30,15",ratio=auto];
node [fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans"];
subgraph cluster_in {label="GİRDİ ve ALGILAMA";color="#5284c7";style="rounded,dashed";penwidth=1.8; bgcolor="#eaf2ff";
"i" [label="M00–M01  GİRİŞ VE SENKRONİZASYON\nKameralar · ego durumu · rota\nKalibrasyon · kaynak izinleri · t0/AoI",shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#5284c7",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.1,margin="0.22,0.18"];
"e" [label="M02 / M23  BAĞIMSIZ KANIT\nBEV, 3B aktör izleri, yol alanı\nTahmin, örtülme, veri yaşı",shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#5284c7",penwidth=1.8,fontname="DejaVu Sans",fontsize=13,width=3.05,margin="0.22,0.18"];
}
