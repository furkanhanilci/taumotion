digraph architecture {
graph [rankdir=LR,bgcolor="white",pad="0.4",nodesep=".5",ranksep=".85",splines=polyline,compound=true,labelloc="t",labeljust="l",label="τMOTION  |  Module Interface Map M00–M23\nExplicit interfaces, not black boxes. Dashed edges: support/training/feedback",fontname="DejaVu Sans",fontsize=26,fontcolor="#61268c",size="30,17",ratio=auto];
