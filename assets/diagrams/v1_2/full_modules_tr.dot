digraph architecture {
graph [rankdir=LR,bgcolor="white",pad="0.4",nodesep=".5",ranksep=".85",splines=polyline,compound=true,labelloc="t",labeljust="l",label="τMOTION  |  Modül Arayüz Haritası M00–M23\nSiyah kutular değil; denetlenebilir veri sözleşmeleri. Kesikli bağlantılar: destek/eğitim/geri besleme",fontname="DejaVu Sans",fontsize=26,fontcolor="#61268c",size="30,17",ratio=auto];
node [fontname="DejaVu Sans"];
